# Environment variables for StenRAG
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── DeepSeek (LLM summarization, container summaries) ──────────────────────
# Obtain from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ── OpenAI (alternative to DeepSeek) ──────────────────────────────────────
# Used by src/llm_client.py when DEEPSEEK_API_KEY is not set.
# OPENAI_API_KEY=sk-your-openai-key-here
